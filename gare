body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav > ul > li:is(:hover, .sfHover, :focus-within, .current-menu-item, .current-menu-ancestor, .current-menu-parent, .current_page_item, .current_page_parent, .current_page_ancestor) > a::after {opacity: 1;}

/* Search + toggle */
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-bar-items {
  z-index: 1;
  position: relative;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 2px;
  margin: 0;
  padding-inline-start: 11px;
  border-left: 1px solid #d9e2e9;
}
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-bar-item > a {
  display: inline-flex;
}
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-bar-item > a,
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-toggle {
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  padding: 0 10px;
  border: 0 !important;
  border-radius: 6px;
  color: var(--nh-lab-navy) !important;
  background: transparent !important;
  box-shadow: none !important;
  transition: background-color .18s ease;
}
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-bar-item > a:hover,
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-toggle:hover { background: #eaf1f5 !important; }
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-toggle .gp-icon svg,
body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-bar-item .gp-icon svg {fill: currentColor;}

/* Submenus */
body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav ul ul {
  box-sizing: border-box;
  width: 245px;
  padding: 7px;
  border: 1px solid #d8e3ea;
  border-radius: 10px;
  background: #fff !important;
  box-shadow: 0 20px 38px rgba(33,52,72,.14);
}
body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav ul ul li a {
  padding: 12px 13px;
  border: 0 !important;
  border-radius: 5px;
  color: var(--nh-lab-navy) !important;
  background: transparent !important;
  background-image: none !important;
  overflow-wrap: anywhere;
}
body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav ul ul li:is(:hover, .sfHover, :focus-within) > a {background: #edf4f7 !important;}
body :is(#site-navigation, #sticky-navigation, #mobile-header) .dropdown-menu-toggle {padding-inline: 8px 0;}

/* Wide desktop strapline */
@media (min-width: 1500px) {
  body :is(#site-navigation, #sticky-navigation) .inside-navigation {padding-inline-end: 120px;}
  body :is(#site-navigation, #sticky-navigation) .inside-navigation::after {
    content: "DATA\A DRIVES\A CLARITY" !important;
    display: block !important;
    white-space: pre;
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 75px;
    padding-left: 10px;
    border-left: 1px solid #c7d7e1;
    color: #637989;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.65;
    pointer-events: none;
  }
}

@media (max-width: 1499px) {
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .inside-navigation::before {display: none;}
}

/* Tablet */
@media (min-width: 769px) and (max-width: 1130px) {
  body :is(#site-navigation, #sticky-navigation) .inside-navigation {
    flex-wrap: wrap;
    gap: 0 9px;
    padding: 7px 16px 11px;
  }
  body :is(#site-navigation, #sticky-navigation) .navigation-branding {min-height: 58px;}
  body :is(#site-navigation, #sticky-navigation) .navigation-branding img {max-width: 210px;max-height: 46px;}
  body :is(#site-navigation, #sticky-navigation) .main-nav {
    order: 5;
    flex: 1 0 100%;
    width: 100%;
    margin: 0;
    padding-top: 5px;
    border-top: 1px solid #e1e8ee;
  }
  body :is(#site-navigation, #sticky-navigation) .main-nav > ul {justify-content: center; flex-wrap: wrap;}
  body :is(#site-navigation, #sticky-navigation) .menu-bar-items {margin-inline-start: auto;}
}

/* Mobile */
@media (max-width: 768px) {
  body :is(#site-navigation, #sticky-navigation, #mobile-header) {padding: 6px 7px 8px;}
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .inside-navigation {
    min-height: 64px;
    flex-wrap: wrap;
    gap: 0 3px;
    padding: 0 7px 0 11px;
    border-radius: 9px;
  }
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .inside-navigation::before {opacity: .19; width: 70px;}
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .navigation-branding {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0 auto 0 0;
    padding-inline-end: 7px;
    border-right: 0;
  }
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .navigation-branding img,
  body #mobile-header .mobile-header-logo img {max-width: min(180px, 42vw); max-height: 40px;}
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-bar-items {gap: 0; padding: 0; border: 0; margin-inline-start: auto;}
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .menu-toggle {
    flex-shrink: 0;
    margin: 0;
  }
  body :is(#site-navigation, #sticky-navigation, #mobile-header).toggled .main-nav {
    order: 5;
    flex: 1 0 100%;
    width: 100%;
    margin: 0;
    padding: 7px 6px 10px;
    border-top: 1px solid #e2e9ef;
  }
  /* GP manages .toggled, menu visibility and the hamburger state natively. */
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav > ul > li > a {
    justify-content: flex-start;
    margin-block: 1px;
    padding: 11px 12px;
    white-space: normal;
  }
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav > ul > li > a::after {inset-inline: 12px;}
  body :is(#site-navigation, #sticky-navigation, #mobile-header) .main-nav ul ul {width: 100%; box-shadow: none;}
  body #mobile-header .mobile-header-logo {margin-inline-end: auto;min-width: 0;}

  /* No :has(#mobile-header) hiding hack: GP hides its default header
     only when Mobile Header is actually enabled in the Customizer. */
}

/* Slideout menu */
body #generate-slideout-menu {background: #f8fbfd !important;}
body #generate-slideout-menu .main-nav > ul > li > a {
  position: relative;
  margin: 4px 11px;
  padding: 14px 16px;
  border: 0 !important;
  border-radius: 5px;
  color: var(--nh-lab-navy) !important;
  background: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
}
body #generate-slideout-menu .main-nav > ul > li:is(:hover, .sfHover, :focus-within) > a {background: #ecf3f7 !important;}
body #generate-slideout-menu .main-nav > ul > li:is(.current-menu-item, .current-menu-ancestor, .current-menu-parent, .current_page_item, .current_page_parent, .current_page_ancestor) > a {
  background: transparent !important;
  box-shadow: none !important;
}
body #generate-slideout-menu .main-nav > ul > li:is(.current-menu-item, .current-menu-ancestor, .current-menu-parent, .current_page_item, .current_page_parent, .current_page_ancestor) > a::after {
  content: "";
  position: absolute;
  inset-inline: 16px;
  bottom: 5px;
  height: 2px;
  background: #a2c868;
  pointer-events: none;
}
body #generate-slideout-menu .slideout-exit {min-width: 44px;min-height: 44px;color:var(--nh-lab-navy) !important;}

/* Accessibility + anchor offset */
body :is(#site-navigation, #sticky-navigation, #mobile-header, #generate-slideout-menu) :is(a, button):focus-visible {
  outline: 2px solid var(--nh-lab-navy);
  outline-offset: 3px;
}
html {scroll-padding-top: 105px;}
@media (min-width: 769px) and (max-width: 1130px) {
  html {scroll-padding-top: 175px;}
  .single-post .entry-content :is(h2, h3, h4) {scroll-margin-top: 175px;}
}
@media (max-width: 768px) {
  html {scroll-padding-top: 100px;}
  .single-post .entry-content :is(h2, h3, h4) {scroll-margin-top: 100px;}
}
@media (prefers-reduced-motion: reduce) {
  body :is(#site-navigation, #sticky-navigation, #mobile-header, #generate-slideout-menu) :is(a, button) {transition: none !important;}
}


/* Concept 06: Research drawers. Article/header typography stays with WordPress. */
body.nh-rd-enabled .nh-rd-layout {
  --nh-rd-ink: #213448;
  --nh-rd-muted: #596775;
  --nh-rd-edge: #dce6ed;
  --nh-rd-surface: #f7f9fa;
  --nh-rd-accent: #ddeb9d;
  display: grid;
  grid-template-columns: 210px minmax(0, 1fr);
  align-items: start;
  gap: clamp(24px, 3vw, 40px);
  margin-block-start: 2em;
}
body.nh-rd-enabled .nh-rd-layout > .entry-content {
  min-width: 0;
  margin-block-start: 0;
  grid-column: 2;
  grid-row: 1;
}
body.nh-rd-enabled .nh-rd-sidebar {
  min-width: 0;
  grid-column: 1;
  grid-row: 1;
  color: var(--nh-rd-ink);
  font-family: inherit;
  font-size: .875rem;
  line-height: 1.5;
}
body.nh-rd-enabled .nh-rd-sidebar *,
body.nh-rd-enabled .nh-rd-sidebar *::before,
body.nh-rd-enabled .nh-rd-sidebar *::after { box-sizing: border-box; }
body.nh-rd-enabled .nh-rd-sidebar [hidden] { display: none !important; }
body.nh-rd-enabled .nh-rd-drawer {
  margin: 0 0 14px;
  border: 1px solid var(--nh-rd-edge);
  border-radius: 9px;
  background: #fff;
  box-shadow: 0 4px 14px rgba(33,52,72,.025);
}
body.nh-rd-enabled .nh-rd-drawer > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 50px;
  padding: 15px;
  border-radius: 8px;
  background: var(--nh-rd-surface);
  color: var(--nh-rd-ink);
  font: inherit;
  font-weight: 650;
  list-style: none;
  cursor: pointer;
}
body.nh-rd-enabled .nh-rd-drawer > summary::-webkit-details-marker { display: none; }
body.nh-rd-enabled .nh-rd-drawer > summary::after {
  content: "";
  width: 7px;
  height: 7px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg);
  flex: 0 0 7px;
  margin: -3px 2px 0 0;
}
body.nh-rd-enabled .nh-rd-drawer[open] > summary {
  border-bottom: 1px solid var(--nh-rd-edge);
  border-radius: 8px 8px 0 0;
}
body.nh-rd-enabled .nh-rd-drawer[open] > summary::after { transform: rotate(225deg); margin-top: 3px; }
body.nh-rd-enabled .nh-rd-links { padding: 8px 10px 12px; }
body.nh-rd-enabled .nh-rd-sidebar a {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 10px 6px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: var(--nh-rd-muted);
  font: inherit;
  text-decoration: none;
  overflow-wrap: anywhere;
}
body.nh-rd-enabled .nh-rd-sidebar a:hover,
body.nh-rd-enabled .nh-rd-sidebar a:focus-visible {
  color: var(--nh-rd-ink);
  background: #f1f5f7;
}
body.nh-rd-enabled .nh-rd-sidebar :is(a,summary):focus-visible {
  outline: 2px solid var(--nh-rd-ink);
  outline-offset: 2px;
}
body.nh-rd-enabled .nh-rd-sidebar svg {
  display: block;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}
body.nh-rd-enabled .nh-rd-sidebar a[aria-current="location"] {
  background: #f4f7ea;
  color: var(--nh-rd-ink);
  box-shadow: inset 3px 0 var(--nh-rd-accent);
}
body.nh-rd-enabled .nh-rd-toc-list,
body.nh-rd-enabled .nh-rd-toc-list li { list-style: none; margin: 0; padding: 0; }
body.nh-rd-enabled .nh-rd-toc-list li.nh-rd-subheading { padding-inline-start: 12px; }
body.nh-rd-enabled .nh-rd-toc-list .nh-rd-subheading a { font-size: .94em; }
@media (max-width: 1023px) {
  body.nh-rd-enabled .nh-rd-layout { display: flex; flex-direction: column; gap: 20px; }
  body.nh-rd-enabled .nh-rd-layout > .entry-content { width: 100%; }
  body.nh-rd-enabled .nh-rd-sidebar { width: 100%; }
}

/* ======================================================================
   DIAGNOSTIC: is the nh-rd markup actually being injected?
   These rules are temporary helpers to tell "missing PHP/JS output"
   apart from "CSS not loading". Remove once the sidebar renders.
   - Red chip shows when body has .nh-rd-enabled but NO .nh-rd-sidebar
     exists in the DOM -> the injector (functions.php / JS) is missing.
   - Dashed placeholder shows when .nh-rd-sidebar exists but is empty
     -> the drawer/TOC generator did not populate it.
   ====================================================================== */
body.nh-rd-enabled:not(:has(.nh-rd-sidebar)) .site::before {
  content: "\26A0 Research Drawers active (body.nh-rd-enabled), but no .nh-rd-sidebar found in the page. The markup-injection code (PHP/JS) is missing or not running.";
  display: block;
  padding: 12px 16px;
  background: #b3261e;
  color: #fff;
  font-size: 14px;
  line-height: 1.4;
}

body.nh-rd-enabled .nh-rd-sidebar:empty {
  min-height: 120px;
  border: 2px dashed #b3261e;
}

body.nh-rd-enabled .nh-rd-sidebar:empty::before {
  content: "Sidebar element exists but is empty \2014 check the drawer/TOC generator.";
  display: block;
  padding: 12px;
  color: #b3261e;
  font-size: 13px;
}
