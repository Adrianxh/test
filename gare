/* Research drawers: sticky sidebar (desktop only).
   Pure CSS, no scroll listeners, so it costs nothing in performance.
   - Sticks just below the sticky navbar.
   - Never taller than the screen: if drawers are opened and get long,
     the sidebar scrolls on its own instead of being cut off.
   - Short screens and tablets/phones keep the normal stacked layout. */
body.nh-rd-enabled { --nh-rd-top: 96px; }
body.nh-rd-enabled.admin-bar { --nh-rd-top: 128px; }
@media (min-width: 1024px) and (min-height: 560px) {
  body.nh-rd-enabled .nh-rd-layout > .nh-rd-sidebar {
    position: sticky;
    top: var(--nh-rd-top);
    align-self: start;
    max-height: calc(100vh - var(--nh-rd-top) - 16px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 2px 4px 2px 2px;   /* room for focus outlines inside the scroll box */
    margin: -2px -4px -2px -2px;
    scrollbar-width: thin;
    scrollbar-color: #c9d5de transparent;
  }
  body.nh-rd-enabled .nh-rd-layout > .nh-rd-sidebar::-webkit-scrollbar { width: 6px; }
  body.nh-rd-enabled .nh-rd-layout > .nh-rd-sidebar::-webkit-scrollbar-thumb { background: #c9d5de; border-radius: 6px; }
  body.nh-rd-enabled .nh-rd-layout > .nh-rd-sidebar::-webkit-scrollbar-track { background: transparent; }
}
@supports (height: 100dvh) {
  @media (min-width: 1024px) and (min-height: 560px) {
    body.nh-rd-enabled .nh-rd-layout > .nh-rd-sidebar { max-height: calc(100dvh - var(--nh-rd-top) - 16px); }
  }
}
